# DonaDoc Backend: variables de entorno. Copie este archivo a ".env" y complete los valores. TODAS están en blanco a propósito.
# ".env" está en .gitignore: NUNCA lo publique.

# ---------- General ----------
# ENVIRONMENT=local aplica las migraciones al arrancar y habilita Swagger; en despliegues use dev, staging o prod y
# ejecute las migraciones una sola vez con 'npm run migration:run'.
ENVIRONMENT=
PORT=
APP_TIMEZONE=
FRONTEND_URL=
CORS_EXTRA_ORIGINS=

# ---------- Base de datos (PostgreSQL en Docker) ----------
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
# Si ejecuta el backend fuera de Docker, apunte a localhost:
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_SSL=

# ---------- Autenticación (JWT RS256) ----------
# Vacío = el backend genera un par de llaves EFÍMERO (solo desarrollo; los tokens caducan al reiniciar).
# En producción: pegue la llave PEM con los saltos de línea como \n.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_EXPIRES_IN=

# ---------- Inteligencia artificial ----------
# Proveedor: gemini (API gratuita de Google AI Studio) | groq (API de Groq) | ollama (modelo local, gratis) | mock (simulador sin IA, para pruebas)
EXTRACTOR_IA_PROVIDER=
# Clave gratuita en https://aistudio.google.com/apikey  (déjela vacía si no la tiene: la extracción queda PENDIENTE)
GEMINI_API_KEY=
GEMINI_MODEL=
# Groq: clave en https://console.groq.com/keys (déjela vacía si no la tiene: la extracción queda PENDIENTE). Modelo: ver console.groq.com/docs/models
GROQ_API_KEY=
GROQ_MODEL=
# Ollama (local, gratis). Recomendado: Ollama instalado en su equipo (usa su GPU) -> http://host.docker.internal:11434
# (con el perfil `ollama` de docker compose use http://ollama:11434). Descargue el modelo: `ollama pull llama3.1:8b`
OLLAMA_URL=
OLLAMA_MODEL=
# Un modelo local tarda ~20 s por historia (y ~35 s en frío): no use menos de 60000.
IA_TIMEOUT_MS=
IA_MAX_INTENTOS=
IA_UMBRAL_CONFIANZA=

# ---------- Correo y códigos OTP (restablecer contraseña, firma del paciente) ----------
# consola = escribe el correo (con el código) en el log: SOLO local/dev; el backend se niega a arrancar así en staging/prod.
# smtp    = cualquier proveedor con capa gratuita (Brevo, Resend, Gmail con clave de aplicación...).
MAIL_PROVIDER=
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
# Secreto (16+ caracteres) que firma los códigos guardados; OBLIGATORIO en producción. Genere uno: openssl rand -hex 32
OTP_PEPPER=
# Llave (64 caracteres hexadecimales = 32 bytes) que cifra los datos clínicos sensibles en la base de datos; OBLIGATORIA en producción.
# Genere una: openssl rand -hex 32. Guárdela aparte: si se pierde, los datos cifrados no se pueden recuperar.
DATA_ENCRYPTION_KEY=
OTP_TTL_MIN=
OTP_MAX_INTENTOS=
OTP_REENVIO_SEG=

# ---------- CDN (opcional; ver docs/CDN.md) ----------
# URL base de los archivos compilados del frontend. Con "/" todo se sirve del mismo origen.
VITE_ASSET_BASE=
# Origen del CDN permitido por la política de contenido (CSP), p. ej. https://cdn.ejemplo.com . Vacío si no hay CDN.
CDN_ORIGIN=

# ---------- Archivos ----------
UPLOAD_DIR=
MAX_UPLOAD_MB=

# ---------- Datos de demostración (solo local) ----------
# Crea una organización y un usuario la primera vez que arranca. La contraseña NO está en el código:
# cámbiela por una propia antes de ejecutar.
SEED_ENABLED=
SEED_TENANT_KEY=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# ---------- Frontend (se incorpora al construir la imagen; es una clave PÚBLICA) ----------
VITE_TENANT_KEY=
# Opcional: URL base de la API si el frontend no está detrás del mismo origen (por defecto /api/v1).
# VITE_API_BASE_URL=/api/v1
